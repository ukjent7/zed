#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.." || exit 1

# The model-facing path list, and the rationale for each entry, live in
# script/l10n-blocklist.txt. It is shared with `script/check-l10n-dict.py` and
# `script/l10n-audit.py` so the three cannot drift apart. Listed paths are
# refused below; `check-l10n-dict.py --strict` covers the other direction,
# reporting a dictionary entry whose English source exists only inside one of
# them.
blocklist=()
while IFS= read -r line; do
  line="${line%%#*}"                # drop a trailing comment
  line="${line//[[:space:]]/}"      # drop all whitespace
  if [[ -n "${line}" ]]; then
    blocklist+=("${line}")
  fi
done < script/l10n-blocklist.txt

# A blocklist entry that stops existing silently stops protecting anything.
# `git grep` only errors when *every* pathspec misses, so a single renamed
# crate quietly drops out of the check while the remaining entries keep the
# result green — upstream renames crates regularly, so say so loudly instead.
for path in "${blocklist[@]}"; do
  if [[ ! -e "${path}" ]]; then
    echo "Error: blocklisted path no longer exists: ${path}"
    echo "Update script/l10n-blocklist.txt (rename) or restore the path; until"
    echo "then that tree is unprotected."
    exit 1
  fi
done

result=$(git grep --no-color --line-number -e 'locale::' -- "${blocklist[@]}" || true)
if [[ -n "${result}" ]]; then
  echo "${result}"
  echo "Error: locale:: must not be used in model-facing paths (see script/l10n-blocklist.txt)."
  exit 1
fi

# `python3` does not exist on every developer machine (Windows ships `python`),
# while CI always has it; probe once so local runs work too.
python="$(command -v python3 || command -v python || true)"
if [[ -z "${python}" ]]; then
  echo "Error: no python interpreter found (need python3 or python)."
  exit 1
fi
"${python}" -m json.tool assets/locales/zh-CN.json > /dev/null
"${python}" -m json.tool assets/locales/actions-zh-CN.json > /dev/null

# Path blocklists cannot see the shape that produced this fork's two real
# leaks: a `Display`/`ToString` impl that localizes, whose value a telemetry
# event in the same GUI-only crate then reports. Check that separately.
"${python}" script/check-l10n-shapes.py || exit 1

echo "l10n boundary check passed."
