#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.." || exit 1

# The model-facing path list, and the rationale for each entry, live in
# script/l10n-blocklist.txt. It is shared with `script/extract-l10n` and
# `script/l10n-audit.py` so the three cannot drift apart. Listed paths are
# refused below; `extract-l10n --strict` covers the other direction, reporting
# a dictionary entry whose English source exists only inside one of them.
blocklist=()
while IFS= read -r line; do
  line="${line%%#*}"                # drop a trailing comment
  line="${line//[[:space:]]/}"      # drop all whitespace
  if [[ -n "${line}" ]]; then
    blocklist+=("${line}")
  fi
done < script/l10n-blocklist.txt

result=$(git grep --no-color --line-number -e 'locale::' -- "${blocklist[@]}" || true)
if [[ -n "${result}" ]]; then
  echo "${result}"
  echo "Error: locale:: must not be used in model-facing paths (see script/l10n-blocklist.txt)."
  exit 1
fi

python3 -m json.tool assets/locales/zh-CN.json > /dev/null
python3 -m json.tool assets/locales/actions-zh-CN.json > /dev/null

echo "l10n boundary check passed."
